import { Button, CheckBox, HorizontalBox, VerticalBox, LineEdit, ScrollView, ComboBox } from "std-widgets.slint";
import { Label, MutedLabel, Theme, TooltipContent, ActionButton } from "theme.slint";
import { RateControl } from "rate-control.slint";
export component SettingsPane inherits Rectangle {
    in property <bool> ru;
    in-out property <string> folder; in-out property <bool> notify;
    in-out property <string> download-rate; in-out property <string> upload-rate;
    in-out property <bool> unlimited-download; in-out property <bool> unlimited-upload;
    in-out property <bool> expanded;
    in-out property <int> theme-choice; in-out property <int> language-choice;
    in-out property <bool> login;
    in-out property <int> download-preset; in-out property <int> upload-preset;
    in property <string> download-equivalent; in property <string> upload-equivalent;
    in property <string> error; in property <bool> busy;
    callback choose-folder(); callback save(); callback cancel(); callback preferences-changed(); callback rates-changed();
    background:Theme.background;
    init=>{folder-button.focus();}
    FocusScope {width:parent.width;height:parent.height;forward-focus:folder-button;
        key-pressed(event)=>{
            if event.text==Key.PageUp {settings-scroll.content-y=min(0px,settings-scroll.content-y + settings-scroll.height);return accept;}
            if event.text==Key.PageDown {settings-scroll.content-y=max(min(0px,settings-scroll.height - settings-scroll.content-height),settings-scroll.content-y - settings-scroll.height);return accept;}
            return reject;
        }
    VerticalBox {padding:28px;spacing:16px;
        Label {text:root.ru ? "Настройки" : "Settings";font-size:22px;font-weight:800;}
        settings-scroll := ScrollView {vertical-stretch:1;
            VerticalBox {padding:0px;spacing:18px;alignment:start;max-width:680px;
                MutedLabel {text:root.ru ? "Изменения применяются после сохранения. Тему можно просмотреть заранее." : "Changes apply after saving. You can preview the theme.";font-size:12px;}
                MutedLabel {text:root.ru ? "ВНЕШНИЙ ВИД" : "APPEARANCE";font-size:12px;font-weight:800;}
                HorizontalBox {spacing:20px;
                    VerticalBox {padding:0px;spacing:6px;
                        Label {text:root.ru ? "Тема" : "Theme";font-weight:600;}
                        ComboBox {model:root.ru ? ["Системная", "Светлая", "Тёмная"] : ["System", "Light", "Dark"];current-index <=> root.theme-choice;enabled:!root.busy;selected=>{root.preferences-changed();}}
                    }
                    VerticalBox {padding:0px;spacing:6px;
                        Label {text:root.ru ? "Язык" : "Language";font-weight:600;}
                        ComboBox {model:["Русский", "English"];current-index <=> root.language-choice;enabled:!root.busy;selected=>{root.preferences-changed();}}
                    }
                }
                Rectangle {height:1px;background:Theme.border;}
                MutedLabel {text:root.ru ? "ОСНОВНЫЕ" : "GENERAL";font-size:12px;font-weight:800;}
                CheckBox {text:root.ru ? "Запускать при входе в систему" : "Launch at login";checked <=> root.login;enabled:!root.busy;}
                Label {text:root.ru ? "Папка новых загрузок" : "Folder for new downloads";font-weight:600;}
                HorizontalBox {vertical-stretch:0;
                    LineEdit {text:root.folder;read-only:true;horizontal-stretch:1;Tooltip {TooltipContent {content:root.folder;}}}
                    folder-button := ActionButton {text:root.ru ? "Изменить…" : "Change…";enabled:!root.busy;clicked=>{root.choose-folder();}}
                }
                MutedLabel {text:root.ru ? "Существующие файлы не перемещаются." : "Existing files stay in their current folder.";font-size:12px;}
                CheckBox {text:root.ru ? "Уведомлять о завершении загрузки" : "Notify when a download completes";checked <=> root.notify;enabled:!root.busy;}
                Rectangle {height:1px;background:Theme.border;}
                MutedLabel {text:root.ru ? "ОГРАНИЧЕНИЯ СКОРОСТИ" : "SPEED LIMITS";font-size:12px;font-weight:800;}
                RateControl {ru:root.ru;busy:root.busy;title:root.ru ? "Общая скорость скачивания" : "Global download limit";preset <=> root.download-preset;value <=> root.download-rate;equivalent:root.download-equivalent;change=>{root.rates-changed();}}
                RateControl {ru:root.ru;busy:root.busy;title:root.ru ? "Общая скорость отдачи" : "Global upload limit";preset <=> root.upload-preset;value <=> root.upload-rate;equivalent:root.upload-equivalent;change=>{root.rates-changed();}}
                MutedLabel {text:root.ru ? "Минимум 0,5 Мбит/с · 1 Мбит/с = 125 КБ/с" : "Minimum 0.5 Mbit/s · 1 Mbit/s = 125 KB/s";font-size:12px;}
            }
        }
        if root.error!="": Label {text:root.error;color:Theme.danger;}
        HorizontalBox {Rectangle {horizontal-stretch:1;}
            ActionButton {text:root.ru ? "Отмена" : "Cancel";enabled:!root.busy;clicked=>{root.cancel();}}
            ActionButton {text:root.ru ? "Сохранить" : "Save";primary:true;enabled:!root.busy;clicked=>{root.save();}}
        }
    }
    }
}
