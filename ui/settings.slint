import { Button, CheckBox, HorizontalBox, VerticalBox, LineEdit, ScrollView } from "std-widgets.slint";
import { Label, MutedLabel, Theme, TooltipContent } from "theme.slint";

export component SettingsPane inherits Rectangle {
    in property <bool> ru;
    in-out property <string> folder;
    in-out property <bool> notify;
    in-out property <string> download-rate;
    in-out property <string> upload-rate;
    in-out property <bool> unlimited-download;
    in-out property <bool> unlimited-upload;
    in-out property <bool> expanded;
    in property <string> error;
    in property <bool> busy;
    callback choose-folder();
    callback save();
    callback cancel();
    background: Theme.background;
    init => { folder-button.focus(); }

    VerticalBox {
        padding: 24px; spacing: 16px;
        Label { text: root.ru ? "Настройки" : "Settings"; font-size: 22px; font-weight: 600; }
        ScrollView {
            vertical-stretch: 1;
            VerticalBox {
                padding: 0px; spacing: 18px; alignment: start;
                MutedLabel { text: root.ru ? "Папка по умолчанию" : "Default download folder"; }
                HorizontalBox {
                    vertical-stretch: 0;
                    LineEdit { text: root.folder; read-only: true; horizontal-stretch: 1; Tooltip { TooltipContent { content: root.folder; } } }
                    folder-button := Button { text: root.ru ? "Изменить…" : "Change…"; enabled: !root.busy; clicked => { root.choose-folder(); } }
                }
                CheckBox { text: root.ru ? "Уведомлять о завершении загрузки" : "Notify when a download completes"; checked <=> root.notify; enabled: !root.busy; }
                HorizontalBox { vertical-stretch: 0;
                    Button { text: (root.expanded ? "▾  " : "▸  ") + (root.ru ? "Скорость" : "Speed"); checkable: true; checked <=> root.expanded; enabled: !root.busy; }
                    Rectangle { horizontal-stretch: 1; }
                }
                if root.expanded: VerticalBox {
                    padding: 0px; spacing: 12px;
                    Label { text: root.ru ? "Скачивание" : "Download"; }
                    HorizontalBox {
                        vertical-stretch: 0;
                        CheckBox { text: root.ru ? "Без ограничения" : "Unlimited"; checked <=> root.unlimited-download; enabled: !root.busy; }
                        LineEdit { text <=> root.download-rate; enabled: !root.unlimited-download && !root.busy; max-width: 110px; }
                        MutedLabel { text: root.ru ? "МБ/с" : "MB/s"; }
                    }
                    Label { text: root.ru ? "Отдача" : "Upload"; }
                    HorizontalBox {
                        vertical-stretch: 0;
                        CheckBox { text: root.ru ? "Без ограничения" : "Unlimited"; checked <=> root.unlimited-upload; enabled: !root.busy; }
                        LineEdit { text <=> root.upload-rate; enabled: !root.unlimited-upload && !root.busy; max-width: 110px; }
                        MutedLabel { text: root.ru ? "МБ/с" : "MB/s"; }
                    }
                    MutedLabel { text: root.ru ? "Минимальный лимит — 0,02 МБ/с." : "Minimum limit: 0.02 MB/s."; }
                }
                Rectangle { vertical-stretch: 1; }
            }
        }
        if root.error != "": Label { text: root.error; font-weight: 600; }
        HorizontalBox {
            Rectangle { horizontal-stretch: 1; }
            Button { text: root.ru ? "Отмена" : "Cancel"; enabled: !root.busy; clicked => { root.cancel(); } }
            Button { text: root.ru ? "Сохранить" : "Save"; primary: true; enabled: !root.busy; clicked => { root.save(); } }
        }
    }
}
