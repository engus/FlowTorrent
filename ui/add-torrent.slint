import { Icons } from "icons.slint";
import { Button, CheckBox, HorizontalBox, VerticalBox, LineEdit, ListView, ScrollView } from "std-widgets.slint";
import { Label, MutedLabel, Theme, TooltipContent, ActionButton } from "theme.slint";
import { PreviewFileRow } from "models.slint";

export component AddTorrentPane inherits Rectangle {
    in property <bool> ru;
    in property <string> torrent-name;
    in property <string> size;
    in property <string> folder;
    in property <string> final-path;
    in property <string> error;
    in property <[PreviewFileRow]> files;
    in property <bool> can-confirm;
    in property <bool> busy;
    in-out property <bool> expanded;
    callback choose-folder();
    callback toggle-file(int, bool);
    callback confirm();
    callback cancel();
    background: Theme.background;
    init => { download-button.focus(); }

    VerticalBox {
        padding: 24px; spacing: 16px;
        Label { text: root.ru ? "Добавить торрент" : "Add torrent"; font-size: 22px; font-weight: 600; }
        ScrollView { vertical-stretch: 1;
        VerticalBox { padding: 0px; spacing: 12px; alignment: start;
        Label {
            text: root.torrent-name; font-size: 16px; font-weight: 600;
            wrap: no-wrap; overflow: elide;
            Tooltip { TooltipContent { content: root.torrent-name; } }
        }
        MutedLabel { text: root.size; }
        MutedLabel { text: root.ru ? "Папка сохранения" : "Save to"; }
        HorizontalBox {
            vertical-stretch: 0;
            LineEdit { text: root.folder; read-only: true; horizontal-stretch: 1; Tooltip { TooltipContent { content: root.folder; } } }
            Button { text: root.ru ? "Изменить…" : "Change…"; enabled: !root.busy; clicked => { root.choose-folder(); } }
        }
        MutedLabel { text: root.final-path; wrap: no-wrap; overflow: elide; Tooltip { TooltipContent { content: root.final-path; } } }
        HorizontalBox { vertical-stretch: 0;
        ActionButton {
            icon: root.expanded ? Icons.chevron-down : Icons.chevron;
            text: (root.ru ? "Файлы" : "Files") + " · " + root.files.length;
            checked: root.expanded; enabled: !root.busy;
            clicked => { root.expanded = !root.expanded; }
        }
        Rectangle { horizontal-stretch: 1; }
        }
        if root.expanded: ListView {
            height: min(180px, root.files.length * 44px);
            for file in root.files: Rectangle {
                height: 44px; background: Theme.surface;
                HorizontalBox {
                    padding: 6px; spacing: 10px;
                    CheckBox {
                        checked: file.checked; enabled: !root.busy;
                        accessible-label: file.name;
                        toggled => { root.toggle-file(file.id, self.checked); }
                    }
                    Label { text: file.name; wrap: no-wrap; overflow: elide; horizontal-stretch: 1; Tooltip { TooltipContent { content: file.name; } } }
                    MutedLabel { text: file.size; horizontal-alignment: right; }
                }
            }
        }
        }}
        if root.error != "": Label { text: root.error; font-weight: 600; }
        HorizontalBox {
            Rectangle { horizontal-stretch: 1; }
            Button { text: root.ru ? "Отмена" : "Cancel"; enabled: !root.busy; clicked => { root.cancel(); } }
            download-button := Button {
                text: root.busy ? (root.ru ? "Добавляем…" : "Adding…") : (root.ru ? "Скачать" : "Download");
                primary: true; enabled: root.can-confirm && !root.busy;
                clicked => { root.confirm(); }
            }
        }
    }
}
