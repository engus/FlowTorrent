import { Palette, VerticalBox } from "std-widgets.slint";
import "../assets/brand/Nunito-400.ttf";
import "../assets/brand/Nunito-600.ttf";
import "../assets/brand/Nunito-800.ttf";
export global Theme {
    in-out property <int> choice;
    in-out property <bool> system-dark: Palette.color-scheme == ColorScheme.dark;
    out property <bool> dark: choice == 0 ? system-dark : choice == 2;
    out property <color> background: dark ? #252525 : #FFFFFF;
    out property <color> sidebar: dark ? #2D2D2D : #F1F1F1;
    out property <color> surface: dark ? #303030 : #F5F5F5;
    out property <color> alternate: dark ? #383838 : #F1F1F1;
    out property <color> foreground: dark ? #F4F4F4 : #262626;
    out property <color> muted: dark ? #AAAAAA : #666666;
    out property <color> border: dark ? #454545 : #D5D5D5;
    out property <color> accent: #007C87;
    out property <color> selection: dark ? #354347 : #DFECEF;
    out property <color> focus: dark ? #57C79A : #007C87;
    out property <color> active: dark ? #58A6FF : #007AFF;
    out property <color> complete: dark ? #57C79A : #16825D;
    out property <color> waiting: dark ? #E7B559 : #A16B12;
    out property <color> danger: dark ? #FF8076 : #C6453D;
}
export component Label inherits Text {
    color: Theme.foreground; font-family: "Nunito"; font-size: 14px;
    wrap: word-wrap; vertical-stretch: 0; vertical-alignment: center;
}
export component MutedLabel inherits Label { color: Theme.muted; }
export component TooltipContent inherits Rectangle {
    in property <string> content;
    max-width: 480px; background: Theme.surface;
    border-width: 1px; border-color: Theme.border; border-radius: 6px;
    VerticalBox { padding: 10px; Label { text: root.content; max-width: 460px; } }
}
export component ActionButton inherits Rectangle {
    in property <string> text;
    in property <string> description: text;
    in property <image> icon;
    in property <bool> primary;
    in property <bool> flat;
    in property <bool> compact;
    in property <bool> left-align;
    in property <bool> muted;
    in property <length> text-size:12px;
    in property <bool> checked;
    in property <bool> enabled: true;
    out property <bool> focused: focus.has-focus;
    callback clicked();
    min-width: text == "" ? (compact ? 30px : 36px) : 92px;
    preferred-width: text == "" ? 36px : label.preferred-width + (icon.width > 0 ? 50px : 26px);
    height: compact ? 30px : 34px; vertical-stretch: 0; horizontal-stretch: 0;
    opacity: enabled ? 1 : 0.4;
    border-radius: 6px; border-width: 1px;
    border-color: focus.has-focus ? Theme.focus : (primary ? Theme.accent : (flat ? transparent : Theme.border));
    background: primary ? Theme.accent : (checked ? Theme.selection : (touch.has-hover ? Theme.alternate : (flat ? transparent : Theme.background)));
    accessible-role: button; accessible-label: description; accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled {root.clicked();} }
    forward-focus: focus;
    HorizontalLayout { padding-left: root.flat ? 0px : 10px; padding-right: root.flat ? 0px : 10px; spacing: 7px;
        if root.icon.width > 0: VerticalLayout { width:18px; alignment:center; Image { width: 18px; height: 18px; source: root.icon; colorize: root.primary ? #FFFFFF : Theme.foreground; } }
        label := Label { text: root.text; color: root.primary ? #FFFFFF : (root.muted ? Theme.muted : Theme.foreground); font-size:root.text-size; font-weight: 600; wrap: no-wrap; horizontal-alignment: root.left-align ? left : center; }
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => { if event.text == Key.Return || event.text == " " {root.clicked(); return accept;} return reject; }
        touch := TouchArea { enabled: root.enabled; clicked => {focus.focus(); root.clicked();} }
    }
    Tooltip { TooltipContent { content: root.description; } }
}

export component NavigationButton inherits Rectangle {
    in property <bool> enabled:true;
    in property <string> text;
    in property <string> count;
    in property <image> icon;
    in property <bool> checked;
    in property <bool> collapsed;
    callback clicked();
    height:40px; vertical-stretch:0; border-radius:6px;
    background:checked ? Theme.selection : (touch.has-hover ? Theme.alternate : transparent);
    border-width:focus.has-focus ? 1px : 0px; border-color:Theme.focus;
    accessible-role:button; accessible-label:text + " " + count;accessible-enabled:root.enabled;
    opacity:root.enabled ? 1 : 0.4;
    accessible-action-default=>{if root.enabled {root.clicked();}}
    forward-focus:focus;
    HorizontalLayout {padding-left:root.collapsed ? (root.width - 16px)/2 : 10px;padding-right:root.collapsed ? (root.width - 16px)/2 : 8px;spacing:root.collapsed ? 0px : 8px;
        VerticalLayout {width:16px;alignment:center;Image {source:root.icon;width:16px;height:16px;colorize:root.checked ? Theme.active : Theme.muted;}}
        if !root.collapsed: Label {text:root.text;font-size:12px;font-weight:root.checked ? 800 : 400;horizontal-stretch:1;overflow:elide;wrap:no-wrap;}
        if !root.collapsed: MutedLabel {text:root.count;font-size:11px;}
    }
    Tooltip {TooltipContent {content:root.text;}}
    focus:=FocusScope {enabled:root.enabled;key-pressed(event)=>{if event.text==Key.Return || event.text==" " {root.clicked();return accept;}return reject;}
        touch:=TouchArea {enabled:root.enabled;clicked=>{focus.focus();root.clicked();}}
    }
}
