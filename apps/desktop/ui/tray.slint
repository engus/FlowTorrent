import { Translations } from "translations.slint";
export component FlowTray inherits SystemTrayIcon {
    icon: @image-url("../../../assets/brand/symbol-small.svg");
    in property <string> status-tooltip: "FlowTorrent";
    in property <string> download-status;
    in property <string> upload-status;
    in property <string> active-status;
    tooltip: root.status-tooltip;
    in property <bool> ru;
    callback reopen();
    callback open-torrent();
    callback quit-requested();
    clicked => { root.reopen(); }
    Menu {
        MenuItem {title:root.download-status;enabled:false;}
        MenuItem {title:root.upload-status;enabled:false;}
        MenuItem {title:root.active-status;enabled:false;}
        MenuSeparator {}
        MenuItem { title: Translations.text("Открыть FlowTorrent","Show FlowTorrent"); activated => { root.reopen(); } }
        MenuItem { title: Translations.text("Добавить торрент…","Add torrent…"); activated => { root.open-torrent(); } }
        MenuSeparator {}
        MenuItem { title: Translations.text("Выйти","Quit"); activated => { root.quit-requested(); } }
    }
}
