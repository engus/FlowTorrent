import { Translations } from "translations.slint";
import { VerticalBox } from "std-widgets.slint";
import { Theme, ActionButton } from "theme.slint";
import { Icons } from "icons.slint";

export component PriorityIcon inherits ActionButton {
    in property <int> priority:1;
    in property <string> target;
    compact:true;flat:true;width:30px;
    icon:root.priority==2 ? Icons.priority-high : root.priority==0 ? Icons.priority-low : Icons.priority-normal;
    description:Translations.text("Приоритет: ","Priority: ")+(root.priority==2 ? Translations.text("Высокий","High") : root.priority==0 ? Translations.text("Низкий","Low") : Translations.text("Нормальный","Normal"))+" · "+root.target;
}
export component PriorityOptions inherits FocusScope {
    in property <int> priority:1;
    enabled:true;
    callback choose(int);
    height:106px;vertical-stretch:0;
    public function focus-current() {if root.priority==2 {high.focus();}else if root.priority==0 {low.focus();}else{normal.focus();}}
    key-pressed(event)=>{
        if event.text==Key.DownArrow {if high.focused {normal.focus();}else if normal.focused {low.focus();}else {high.focus();}return accept;}
        if event.text==Key.UpArrow {if low.focused {normal.focus();}else if normal.focused {high.focus();}else {low.focus();}return accept;}
        return reject;
    }
    VerticalBox {padding:0px;spacing:2px;
        high:=ActionButton {flat:true;left-align:true;horizontal-stretch:1;text:Translations.text("Высокий","High");icon:Icons.priority-high;checked:root.priority==2;enabled:root.enabled;
            clicked=>{root.choose(2);}if root.priority==2: Image {source:Icons.check;width:14px;height:14px;x:parent.width - 18px;y:(parent.height - self.height)/2;colorize:Theme.foreground;}}
        normal:=ActionButton {flat:true;left-align:true;horizontal-stretch:1;text:Translations.text("Нормальный","Normal");icon:Icons.priority-normal;checked:root.priority==1;enabled:root.enabled;
            clicked=>{root.choose(1);}if root.priority==1: Image {source:Icons.check;width:14px;height:14px;x:parent.width - 18px;y:(parent.height - self.height)/2;colorize:Theme.foreground;}}
        low:=ActionButton {flat:true;left-align:true;horizontal-stretch:1;text:Translations.text("Низкий","Low");icon:Icons.priority-low;checked:root.priority==0;enabled:root.enabled;
            clicked=>{root.choose(0);}if root.priority==0: Image {source:Icons.check;width:14px;height:14px;x:parent.width - 18px;y:(parent.height - self.height)/2;colorize:Theme.foreground;}}
    }
}
