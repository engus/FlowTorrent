import { Translations } from "translations.slint";
import { Icons } from "icons.slint";
import { CheckBox, HorizontalBox, VerticalBox, LineEdit, ListView, ScrollView } from "std-widgets.slint";
import { Label, MutedLabel, Theme, TooltipContent, ActionButton } from "theme.slint";
import { PreviewFileRow } from "models.slint";

export component AddTorrentPane inherits Rectangle {
    in property <int> focus-ticket;
    changed focus-ticket=>{download-button.focus();}
    in property <bool> ru;
    in property <string> torrent-name;
    in property <string> size;
    in property <string> folder;
    in property <string> final-path;
    in property <string> error;
    in property <[PreviewFileRow]> files;
    in property <bool> can-confirm;
    in property <bool> busy;
    in-out property <bool> expanded;
    callback choose-folder();
    callback toggle-file(int, bool);
    callback confirm();
    callback cancel();
    background: Theme.background;
    init => { download-button.focus(); }

    VerticalBox {
        padding: 24px; spacing: 16px;
        Label { text: Translations.text("Добавить торрент","Add torrent"); font-size: 22px; font-weight: 600; }
        ScrollView { vertical-stretch: 1;
        VerticalBox { padding: 0px; spacing: 12px; alignment: start;
        Label {
            text: root.torrent-name; font-size: 16px; font-weight: 600;
            wrap: no-wrap; overflow: elide;
            Tooltip { TooltipContent { content: root.torrent-name; } }
        }
        Label { text: Translations.text("Папка сохранения","Save to"); font-size:13px; font-weight:600; }
        HorizontalBox {
            vertical-stretch: 0;
            LineEdit { text: root.folder; read-only: true; horizontal-stretch: 1; Tooltip { TooltipContent { content: root.folder; } } }
            ActionButton { text: Translations.text("Изменить…","Change…"); enabled: !root.busy; clicked => { root.choose-folder(); } }
        }
        HorizontalBox { vertical-stretch: 0;
        ActionButton {
            icon: root.expanded ? Icons.chevron-down : Icons.chevron;
            text: (Translations.text("Файлы","Files")) + " · " + root.files.length;
            checked: root.expanded; enabled: !root.busy;
            clicked => { root.expanded = !root.expanded; }
        }
        Rectangle { horizontal-stretch: 1; }
        }
        if root.expanded: Rectangle {
            height: min(182px, root.files.length * 44px + 2px);
            background:Theme.background;border-width:1px;border-color:Theme.border;border-radius:6px;
            ListView {x:1px;y:1px;width:parent.width - 2px;height:parent.height - 2px;
            for file in root.files: Rectangle {
                height: 44px; background: Theme.background;
                Rectangle {y:parent.height - 1px;width:parent.width;height:1px;background:Theme.border;}
                HorizontalBox {
                    padding-left: 12px; padding-right: 12px; padding-top: 8px; padding-bottom: 8px; spacing: 12px;
                    CheckBox {
                        checked: file.checked; enabled: !root.busy;
                        accessible-label: file.name;
                        toggled => { root.toggle-file(file.id, self.checked); }
                    }
                    Label { text: file.name; font-size:13px; wrap: no-wrap; overflow: elide; horizontal-stretch: 1; Tooltip { TooltipContent { content: file.name; } } }
                    MutedLabel { text: file.size; font-size:12px; horizontal-alignment: right; }
                }
            }
            }
        }
        HorizontalBox {padding:0px;spacing:12px;vertical-stretch:0;
            Label {text:Translations.text("Объём загрузки","Download size");font-size:13px;horizontal-stretch:1;}
            Label {text:root.size;font-size:13px;font-weight:600;horizontal-alignment:right;}
        }
        Label {text:Translations.text("Расположение результата","Final location");font-size:13px;font-weight:600;}
        Rectangle {background:Theme.surface;border-width:1px;border-color:Theme.border;border-radius:6px;vertical-stretch:0;
            VerticalBox {padding:12px;
                MutedLabel {text:root.final-path;font-size:13px;wrap:word-wrap;overflow:elide;Tooltip {TooltipContent {content:root.final-path;}}}
            }
        }
        }}
        if root.error != "": Label { text: root.error; color:Theme.danger; font-size:12px; }
        Rectangle {height:1px;background:Theme.border;}
        HorizontalBox {
            Rectangle { horizontal-stretch: 1; }
            ActionButton { text: Translations.text("Отмена","Cancel"); text-size:13px; enabled: !root.busy; clicked => { root.cancel(); } }
            download-button := ActionButton {
                text: root.busy ? (Translations.text("Добавляем…","Adding…")) : (Translations.text("Скачать","Download"));
                text-size:13px;
                primary: true; enabled: root.can-confirm && !root.busy;
                clicked => { root.confirm(); }
            }
        }
    }
}
